# Default: no API key required; Mock demo works out of the box.
ANALYSIS_MODE=mock

# Fill these only after the user provides the real Qwen API configuration.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
QWEN_API_PROTOCOL=openai-compatible

# Model-specific bbox coordinate mode. Confirm against the selected model docs.
QWEN_BBOX_COORD_MODE=normalized_0_999
MAX_UPLOAD_MB=7
QWEN_TIMEOUT_MS=90000
