'use client';
import {useState} from 'react';
import data from '../config/mock_scenarios.json';
import standard from '../config/tool_inventory.json';
const boxes=[[130,45,420,725],[345,65,455,530],[745,80,865,610],[455,70,745,710],[420,755,790,815],[420,815,790,875]];
export default function Home(){const [selected,setSelected]=useState(data.scenarios[1]);const [result,setResult]=useState<typeof selected|null>(data.scenarios[1]);const [image,setImage]=useState('/samples/complete_reference.jpg');const [show,setShow]=useState(true);const [loading,setLoading]=useState(false);const [error,setError]=useState('');const [custom,setCustom]=useState(false);
async function analyze(){setLoading(true);setError('');try{if(custom){setError('照片已就绪。视觉识别服务尚未连接，请先使用参考照片核验流程。');return}const blob=await fetch(image).then(r=>r.blob());const form=new FormData();form.append('image',blob,selected.file);form.append('sampleId',selected.sampleId);form.append('mode','mock');const response=await fetch('/api/analyze',{method:'POST',body:form});const payload=await response.json();if(!response.ok)throw new Error(payload.error?.message||'请求失败');setResult(payload.scenario)}catch(e){setError(e instanceof Error?e.message:'请求失败，请重试')}finally{setLoading(false)}}
return <main><header><div className="brand"><span className="logo">▦</span><div><b>TOOLBOX VISION</b><small>工具管理 / 视觉盘点</small></div></div><span className="pill">本地工作区</span></header><div className="worktitle"><div><h1>工具盒盘点</h1><p>上传工具盒照片，对照清单核验工具数量与归位情况。</p></div><span>黄色工具盒 · 清单 V1.0</span></div><section className="overview"><div><span>清单基线</span><strong>{standard.items.reduce((n,x)=>n+x.expectedCount,0)}<small> 件</small></strong><p>六类工具 · 暂定标准</p></div><div><span>本次盘点</span><strong>{result?Object.values(result.observedCounts).reduce((a,b)=>a+b,0):"—"}<small> 件</small></strong><p>当前照片 / 情景结果</p></div><div className="danger"><span>缺失数量</span><strong>{result?result.missing.reduce((n,x)=>n+x.missingCount,0):"—"}<small> 件</small></strong><p>{result?.missing.length?"需要核对并补齐":"暂无缺失结论"}</p></div><div><span>任务状态</span><strong className="statustext">{loading?"核验中":result?(result.missing.length?"待补齐":"已核对"):"待分析"}</strong><p>参考结果 · 人工确认后闭环</p></div></section><div className="workspace"><aside><h2><span>01</span> 图片来源</h2><div className="samples">{data.scenarios.map((s,i)=><button className={selected.sampleId===s.sampleId&&!custom?'sample active':'sample'} key={s.sampleId} onClick={()=>{setSelected(s);setImage('/samples/complete_reference.jpg');setCustom(false);setResult(s);setError('')}}><img src='/samples/complete_reference.jpg' alt={s.label}/><div><small>{i===0?"完整参考":"缺失情景预览"}</small><b>{s.label}</b><span>{i===0?'按清单核对':s.sampleId==='missing_socket'?'套筒 8 → 7':s.sampleId==='missing_bits'?'批头 40 → 37':'长延长杆 1 → 0'}</span></div></button>)}</div><label className="upload">＋ 点击上传工具盒照片<input type="file" accept="image/jpeg,image/png,image/webp" onChange={e=>{const f=e.target.files?.[0];if(!f)return;if(f.size>7*1024*1024){setError('图片不能超过 7 MB');return}if(!['image/jpeg','image/png','image/webp'].includes(f.type)){setError('请选择 JPG、PNG 或 WEBP 图片');return}if(image.startsWith('blob:'))URL.revokeObjectURL(image);setImage(URL.createObjectURL(f));setCustom(true);setResult(null);setError('')}}/></label><p className="muted">JPG / PNG / WEBP，最大 7 MB</p><button className="primary" disabled={loading} onClick={analyze}>{loading?'正在核对工具清单…':'开始盘点分析 →'}</button><button className="reset" onClick={()=>{setResult(null);setImage("/samples/"+data.scenarios[0].file);setSelected(data.scenarios[0]);setCustom(false);setError("")}}>重置盘点</button>{error&&<p className="error">{error}</p>}<p className="disclaimer">{custom?'照片已上传。当前仅支持预览；真实照片分析接口待接入，不会套用样例结论。':'缺失情景使用原始参考图叠加提示，不代表照片真实缺失。'}</p></aside><section className="viewer"><div className="sectionbar"><h2><span>02</span> 照片工作区</h2><label><input type="checkbox" checked={show} onChange={e=>setShow(e.target.checked)}/> 显示检测框</label></div>{result&&<section className={result.missing.length?'conclusion missing':'conclusion complete'}><div><small>盘点结论 · 情景预览</small><h2>{result.missing.length?'发现工具缺失，请核对后再收箱':'工具清单数量一致'}</h2><p>{result.missing.length?'橙色区域为情景预设位置，照片使用完整参考图。':'当前样例未发现数量差异；正式标准仍需人工确认。'}</p></div><div className="findingcards">{result.missing.length?result.missing.map(m=>{const item=standard.items.find(it=>it.classId===m.classId)!;const n=result.observedCounts[m.classId as keyof typeof result.observedCounts];return <article key={m.classId}><strong>{m.label}</strong><b>缺少 {m.missingCount} {m.classId==='bit_head'?'枚':m.classId==='long_extension_bar'?'根':'个'}</b><span>清单 {item.expectedCount} → 当前 {n}</span><small>{m.classId==='bit_head'?'批头为分组区域提示，数量暂定':'在照片橙色虚线区域核对空槽'}</small></article>}):<article><strong>全部项目数量一致</strong><b>未发现缺失</b><span>六类工具按暂定清单核对</span></article>}</div></section>}<div className="imagearea"><div className="imagewrap"><img src={image} alt="待检测工具盒"/>{result&&show&&<svg viewBox="0 0 1000 1000" preserveAspectRatio="none">{standard.items.filter(item=>!result.missing.some(m=>m.classId===item.classId)).map((item)=>{const b=boxes[standard.items.findIndex(it=>it.classId===item.classId)];return <g key={item.classId}><rect x={b[0]} y={b[1]} width={b[2]-b[0]} height={b[3]-b[1]} stroke="#55e5a4"/></g>})}{result.missing.map(m=><g key={m.classId}><rect className="missingbox" x={m.bbox[0]} y={m.bbox[1]} width={m.bbox[2]-m.bbox[0]} height={m.bbox[3]-m.bbox[1]}/><text x={m.bbox[0]} y={m.bbox[1]-5} fill="#ffaf68">{m.label} · 缺 {m.missingCount}</text></g>)}</svg>}</div></div><div className="caption"><span>● {custom?'自定义图片 / 模拟结果':selected.label}</span><span>归一化坐标 · 随图缩放</span></div></section></div><section className="results"><div className="sectionbar"><h2><span>03</span> 工具清单明细</h2><span className="pill">{result?(result.status==='complete'?'未发现数量差异':'发现缺失 · 请处理'):'等待开始盘点'}</span></div>{result?<>{result.missing.map(m=><p className="alert" key={m.classId}>⚠ {m.label}缺少 {m.missingCount} 件{m.classId==='bit_head'?'（标准数量暂定）':''}</p>)}<div className="tablewrap"><table><thead><tr><th>工具名称</th><th>标准数量</th><th>盘点数量</th><th>缺失数量</th><th>状态</th></tr></thead><tbody>{standard.items.map(it=>{const n=result.observedCounts[it.classId as keyof typeof result.observedCounts];const missing=Math.max(0,it.expectedCount-n);return <tr key={it.classId}><td>{it.label}{it.provisional&&<small className="tag">暂定标准</small>}</td><td>{it.expectedCount}</td><td>{n}</td><td>{missing||'—'}</td><td className={missing?'orange':'green'}>{missing?'缺失':'齐全'}</td></tr>})}</tbody></table></div></>:<div className="empty">请上传工具盒照片，或选择参考照片开始盘点。</div>}</section><footer>TOOLBOX VISION　｜　参考照片结果为预设数据，非实时视觉识别。</footer></main>}







