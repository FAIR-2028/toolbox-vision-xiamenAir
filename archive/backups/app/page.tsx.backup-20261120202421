'use client';
import {useState} from 'react';
import data from '../config/mock_scenarios.json';
import standard from '../config/tool_inventory.json';
const boxes=[[130,45,420,725],[345,65,455,530],[745,80,865,610],[455,70,745,710],[420,755,790,815],[420,815,790,875]];
export default function Home(){const [selected,setSelected]=useState(data.scenarios[0]);const [result,setResult]=useState<typeof selected|null>(null);const [image,setImage]=useState('/samples/'+selected.file);const [show,setShow]=useState(true);const [loading,setLoading]=useState(false);const [error,setError]=useState('');const [custom,setCustom]=useState(false);
async function analyze(){setLoading(true);setError('');try{if(custom){setError('自定义图片仅支持预览，请选择左侧样例演示');return}const blob=await fetch(image).then(r=>r.blob());const form=new FormData();form.append('image',blob,selected.file);form.append('sampleId',selected.sampleId);form.append('mode','mock');const response=await fetch('/api/analyze',{method:'POST',body:form});const payload=await response.json();if(!response.ok)throw new Error(payload.error?.message||'请求失败');setResult(payload.scenario)}catch(e){setError(e instanceof Error?e.message:'请求失败，请重试')}finally{setLoading(false)}}
return <main><header><div className="brand"><span className="logo">▦</span><div><b>TOOLBOX VISION</b><small>机务工具视觉盘点工作台</small></div></div><span className="pill">● MOCK 演示模式</span></header><section className="hero"><div><p className="eyebrow">VISUAL INSPECTION / DEMO 01</p><h1>每一件工具，<br/><em>一目了然。</em></h1><p>上传工具盒照片，直观查看识别区域、工具数量与缺失提示。</p></div><div className="note"><b>无需 API，即刻演示</b><p>四个固定场景 · 可重复结果<br/>当前数据为模拟结果，不代表真实识别。</p></div></section><div className="workspace"><aside><h2><span>01</span> 选择演示场景</h2><div className="samples">{data.scenarios.map((s,i)=><button className={selected.sampleId===s.sampleId&&!custom?'sample active':'sample'} key={s.sampleId} onClick={()=>{setSelected(s);setImage('/samples/'+s.file);setCustom(false);setResult(null);setError('')}}><img src={'/samples/'+s.file} alt={s.label}/><div><small>SCENARIO 0{i+1}</small><b>{s.label}</b><span>{i===0?'按暂定标准齐全':'模拟缺失场景'}</span></div></button>)}</div><label className="upload">＋ 上传自己的图片<input type="file" accept="image/jpeg,image/png,image/webp" onChange={e=>{const f=e.target.files?.[0];if(!f)return;if(f.size>7*1024*1024){setError('图片不能超过 7 MB');return}if(!['image/jpeg','image/png','image/webp'].includes(f.type)){setError('请选择 JPG、PNG 或 WEBP 图片');return}if(image.startsWith('blob:'))URL.revokeObjectURL(image);setImage(URL.createObjectURL(f));setCustom(true);setResult(null);setError('')}}/></label><p className="muted">JPG / PNG / WEBP，最大 7 MB</p><button className="primary" disabled={loading} onClick={analyze}>{loading?'正在生成演示结果…':'开始模拟识别 →'}</button>{error&&<p className="error">{error}</p>}<p className="disclaimer">{custom?'自定义图片仅展示当前所选场景的模拟结果，不进行真实图像分析。':'缺失样例为合成素材，不用于模型准确率评估。'}</p></aside><section className="viewer"><div className="sectionbar"><h2><span>02</span> 图像检测区域</h2><label><input type="checkbox" checked={show} onChange={e=>setShow(e.target.checked)}/> 显示检测框</label></div><div className="imagearea"><div className="imagewrap"><img src={image} alt="待检测工具盒"/>{result&&show&&<svg viewBox="0 0 1000 1000" preserveAspectRatio="none">{standard.items.map((item,i)=>{const b=boxes[i];return <g key={item.classId}><rect x={b[0]} y={b[1]} width={b[2]-b[0]} height={b[3]-b[1]} stroke="#55e5a4"/><text x={b[0]+4} y={b[1]+18}>{item.label}</text></g>})}{result.missing.map(m=><g key={m.classId}><rect className="missingbox" x={m.bbox[0]} y={m.bbox[1]} width={m.bbox[2]-m.bbox[0]} height={m.bbox[3]-m.bbox[1]}/><text x={m.bbox[0]} y={m.bbox[1]-5} fill="#ffaf68">缺失 {m.missingCount}</text></g>)}</svg>}</div></div><div className="caption"><span>● {custom?'自定义图片 / 模拟结果':selected.label}</span><span>归一化坐标 · 随图缩放</span></div></section></div><section className="results"><div className="sectionbar"><h2><span>03</span> 盘点结果</h2><span className="pill">{result?(result.status==='complete'?'完整 · Demo 暂定标准':'发现模拟缺失'):'等待模拟识别'}</span></div>{result?<><div className="stats"><div><small>暂定标准总数</small><strong>52 <i>件</i></strong></div><div><small>模拟识别数量</small><strong>{Object.values(result.observedCounts).reduce((a,b)=>a+b,0)} <i>件</i></strong></div><div><small>缺失种类</small><strong>{result.missing.length} <i>类</i></strong></div><div><small>当前结果来源</small><strong className="mock">MOCK</strong></div></div>{result.missing.map(m=><p className="alert" key={m.classId}>⚠ {m.label}缺少 {m.missingCount} 件{m.classId==='bit_head'?'（标准数量暂定）':''}</p>)}<div className="tablewrap"><table><thead><tr><th>工具名称</th><th>标准数量</th><th>模拟数量</th><th>缺失数量</th><th>状态</th></tr></thead><tbody>{standard.items.map(it=>{const n=result.observedCounts[it.classId as keyof typeof result.observedCounts];const missing=Math.max(0,it.expectedCount-n);return <tr key={it.classId}><td>{it.label}{it.provisional&&<small className="tag">暂定标准</small>}</td><td>{it.expectedCount}</td><td>{n}</td><td>{missing||'—'}</td><td className={missing?'orange':'green'}>{missing?'缺失':'齐全'}</td></tr>})}</tbody></table></div></>:<div className="empty">选择左侧样例并点击“开始模拟识别”，在此查看工具清单与差异。</div>}</section><footer>MOCK DEMO · 所有识别结果均为模拟数据；批头数量与总数未经人工核验，不作为正式盘点标准。</footer></main>}

