<body>
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">T</div>
      <div>
        <div class="brand-name">机务小工具智能盘点</div>
        <div class="brand-sub">TOOLBOX VISION · INSPECTION WORKSPACE</div>
      </div>
    </div>
    <div class="top-right">
      <span class="top-pill"><i class="dot"></i> 盘点工作区</span>
      <span class="top-pill">清单 V1.0</span>
    </div>
  </header>

  <main>
    <section class="page-head">
      <div>
        <div class="eyebrow">TOOL INVENTORY / VISUAL INSPECTION</div>
        <h1>工具盒完整性检查</h1>
        <p class="subtitle">上传现场照片，识别工具类别与数量，对照标准清单，并直观定位缺失项。</p>
      </div>
      <div class="actions">
        <input id="fileInput" type="file" accept="image/jpeg,image/png,image/webp" hidden />
        <button class="btn" id="uploadBtn">＋ 上传现场照片</button>
        <button class="btn btn-primary" id="reanalyzeBtn">重新分析 ↻</button>
      </div>
    </section>

    <div class="notice">
      <div class="notice-icon">ⓘ</div>
      <div><strong>参考情景采用预设盘点结果，标准清单待人工核定。</strong>
        支持上传现场照片预览。缺失情景含合成素材；真实照片分析服务尚待接入。
      </div>
    </div>

    <section class="metrics">
      <div class="metric">
        <div class="metric-top"><span class="metric-label">标准工具数量</span><span class="metric-icon">▤</span></div>
        <div class="metric-value" id="expectedMetric">52</div>
        <div class="metric-foot">含约 40 枚批头的暂定基线</div>
      </div>
      <div class="metric">
        <div class="metric-top"><span class="metric-label">本次识别数量</span><span class="metric-icon">⌕</span></div>
        <div class="metric-value" id="observedMetric">51</div>
        <div class="metric-foot">当前选中样例的固定演示值</div>
      </div>
      <div class="metric">
        <div class="metric-top"><span class="metric-label">缺失数量</span><span class="metric-icon" style="color:#d93b45;background:#fff0f0">!</span></div>
        <div class="metric-value" id="missingMetric" style="color:#d93b45">1</div>
        <div class="metric-foot">按暂定标准清单计算</div>
      </div>
      <div class="metric">
        <div class="metric-top"><span class="metric-label">待人工复核</span><span class="metric-icon" style="color:#b7791f;background:#fff7e7">◷</span></div>
        <div class="metric-value" id="reviewMetric">1</div>
        <div class="metric-foot">批头数量为低置信度估算</div>
      </div>
    </section>

    <section class="workspace">
      <div class="card">
        <div class="card-head">
          <div>
            <div class="card-title">图像检测结果</div>
            <div class="card-desc">绿色：识别到的工具 · 红色：缺失位置 · 黄色：需人工复核</div>
          </div>
          <span class="tag blue" id="modeTag">参考情景</span>
        </div>
        <div class="viewer-toolbar">
          <div class="file-meta">
            <span>▧</span>
            <span class="file-name" id="fileName">missing-one-socket.png</span>
            <span id="imageDimensions">1279 × 1706</span>
          </div>
          <div class="view-tools">
            <span>显示检测标注</span>
            <button class="switch on" id="overlaySwitch" aria-label="显示检测标注" aria-pressed="true"></button>
          </div>
        </div>
        <div class="image-stage">
          <div class="photo-wrap" id="photoWrap">
            <img id="mainImage" src="/samples/missing_one_socket.jpg" alt="工具盒样例图片" />
            <div class="overlay" id="overlay"></div>
            <div class="upload-empty" id="uploadEmpty">
              <strong>图片已上传，等待真实识别</strong>
              当前原型未连接 Qwen API。此处不会显示虚构的检测框或盘点结果。
            </div>
          </div>
        </div>
        <div class="viewer-footer">
          <div class="legend">
            <span class="legend-item"><i class="legend-dot"></i> 已识别工具</span>
            <span class="legend-item"><i class="legend-dot red"></i> 缺失 / 空槽位</span>
            <span class="legend-item"><i class="legend-dot amber"></i> 需人工复核</span>
          </div>
          <span id="sourceNote">来源：合成缺失样例 · 固定 Mock 结果</span>
        </div>
      </div>

      <aside class="result-panel">
        <div class="card">
          <div class="card-head">
            <div>
              <div class="card-title">盘点结论</div>
              <div class="card-desc">基于当前样例与暂定标准清单</div>
            </div>
            <span class="tag red" id="verdictTag">发现缺失</span>
          </div>
          <div class="section-card">
            <div class="verdict" id="verdictBox">
              <div class="verdict-kicker" id="verdictKicker">INCOMPLETE · 需补齐</div>
              <div class="verdict-main">
                <div class="verdict-count" id="verdictCount">缺少 1 件</div>
                <span class="tag red">异常</span>
              </div>
              <div class="verdict-copy" id="verdictCopy">发现 1 项缺失，请根据图中红色位置检查工具盒。</div>
            </div>
          </div>
          <div class="section-card" style="padding-top:0">
            <div class="section-head"><h3>缺失项定位</h3><span id="missingCountLabel">1 项待补齐</span></div>
            <div class="missing-list" id="missingList"></div>
          </div>
        </div>

        <div class="card section-card">
          <div class="section-head">
            <h3>工具清单核对</h3>
            <span>标准数量为暂定值</span>
          </div>
          <table class="inventory">
            <thead><tr><th>工具类别</th><th>标准</th><th>识别</th><th>差异</th><th>状态</th></tr></thead>
            <tbody id="inventoryBody"></tbody>
          </table>
        </div>
      </aside>
    </section>

    <section class="card samples">
      <div class="card-head">
        <div>
          <div class="card-title">参考情景</div>
          <div class="card-desc">点击切换不同场景，查看缺失结论和图像标注如何变化。</div>
        </div>
        <span class="tag">4 个盘点情景</span>
      </div>
      <div class="sample-grid" id="sampleGrid">
        <button class="sample-card" data-sample="complete">
          <span class="sample-badge">原始照片</span>
          <div class="sample-thumb"><img src="/samples/complete_reference.jpg" alt="" /></div>
          <div class="sample-copy"><div class="sample-title">完整工具盒</div><div class="sample-sub">按暂定清单：未发现缺失</div></div>
        </button>
        <button class="sample-card active" data-sample="socket">
          <span class="sample-badge">合成图片</span>
          <div class="sample-thumb"><img src="/samples/missing_one_socket.jpg" alt="" /></div>
          <div class="sample-copy"><div class="sample-title">缺少 1 个套筒</div><div class="sample-sub">套筒 7 / 8 · 缺少 1 个</div></div>
        </button>
        <button class="sample-card" data-sample="bits">
          <span class="sample-badge">合成图片</span>
          <div class="sample-thumb"><img src="/samples/missing_three_bits.jpg" alt="" /></div>
          <div class="sample-copy"><div class="sample-title">缺少 3 枚批头</div><div class="sample-sub">批头约 37 / 40 · 缺少 3 枚</div></div>
        </button>
        <button class="sample-card" data-sample="extension">
          <span class="sample-badge">合成图片</span>
          <div class="sample-thumb"><img src="/samples/missing_long_extension.jpg" alt="" /></div>
          <div class="sample-copy"><div class="sample-title">缺少 1 根长延长杆</div><div class="sample-sub">长延长杆 0 / 1 · 缺少 1 根</div></div>
        </button>
      </div>
    </section>

    <p class="bottom-note">
      说明：本页用于确认信息层级、颜色、交互与结果呈现，不代表真实模型识别效果。批头标准数量约 40 枚，属于单张参考照片上的初步估算；正式盘点前需要人工确认。缺失物品没有实际检测框时，只能在模型可靠识别到空槽位的情况下标出位置，否则应显示“位置未可靠定位，请人工复核”。
    </p>
  </main>
  <div class="toast" id="toast"></div>

  <script>
    const inventoryBase = [
      { id: "large", name: "大号螺丝刀手柄组件", expected: 1, unit: "件" },
      { id: "small", name: "小号螺丝刀手柄组件", expected: 1, unit: "件" },
      { id: "socket", name: "套筒", expected: 8, unit: "个" },
      { id: "bits", name: "批头（暂定）", expected: 40, unit: "枚" },
      { id: "short", name: "短延长杆 / 转接杆", expected: 1, unit: "根" },
      { id: "long", name: "长延长杆", expected: 1, unit: "根" }
    ];
    const scenarios = {
      complete: {
        image: "/samples/complete_reference.jpg", file: "complete-reference.jpg", dims: "1279 × 1706",
        observed: { large:1, small:1, socket:8, bits:40, short:1, long:1 },
        missing: [], review: 1, status: "complete",
        source: "来源：用户原始参考照片 · 固定 Mock 结果",
        boxes: [
          ["large",14,6,26,53,"大号手柄 ×1","green"],
          ["small",40,8,16,51,"小号手柄 ×1","green"],
          ["bits",50,8,21,62,"批头区域 · 约40枚","amber"],
          ["socket",73,7,16,61,"套筒区域 · 8个","green"],
          ["short",40,76,43,8,"短延长杆 ×1","green"],
          ["long",40,85,43,8,"长延长杆 ×1","green"]
        ]
      },
      socket: {
        image: "/samples/missing_one_socket.jpg", file: "missing-one-socket.png", dims: "1279 × 1706",
        observed: { large:1, small:1, socket:7, bits:40, short:1, long:1 },
        missing: [{id:"socket", name:"套筒", expected:8, observed:7, count:1, unit:"个", location:"右侧套筒收纳位 · 第 3 个空槽"}],
        review: 1, status: "missing",
        source: "来源：合成缺失样例 · 固定 Mock 结果",
        boxes: [
          ["large",14,6,26,53,"大号手柄 ×1","green"],
          ["small",40,8,16,51,"小号手柄 ×1","green"],
          ["bits",50,8,21,62,"批头区域 · 约40枚","amber"],
          ["socket-1",73,7,16,7,"套筒 1","green"],
          ["socket-2",73,16,16,7,"套筒 2","green"],
          ["socket-3",73,25,16,7,"缺失槽位","red"],
          ["socket-4",73,34,16,7,"套筒 4","green"],
          ["socket-5",73,43,16,7,"套筒 5","green"],
          ["socket-6",73,52,16,7,"套筒 6","green"],
          ["socket-7",73,61,16,7,"套筒 7","green"],
          ["short",40,76,43,8,"短延长杆 ×1","green"],
          ["long",40,85,43,8,"长延长杆 ×1","green"]
        ]
      },
      bits: {
        image: "/samples/missing_three_bits.jpg", file: "missing-three-bits.jpg", dims: "1279 × 1706",
        observed: { large:1, small:1, socket:8, bits:37, short:1, long:1 },
        missing: [{id:"bits", name:"批头（暂定）", expected:40, observed:37, count:3, unit:"枚", location:"中上部批头收纳区 · 具体空槽需复核"}],
        review: 1, status: "missing",
        source: "来源：合成缺失样例 · 固定 Mock 结果",
        boxes: [
          ["large",14,6,26,53,"大号手柄 ×1","green"],
          ["small",40,8,16,51,"小号手柄 ×1","green"],
          ["bits",48,8,24,62,"批头区域 · 约37/40","amber"],
          ["bit-hole-1",46,16,3,4,"","red"],
          ["bit-hole-2",53,16,3,4,"","red"],
          ["bit-hole-3",59,16,3,4,"","red"],
          ["socket",73,7,16,61,"套筒区域 · 8个","green"],
          ["short",40,76,43,8,"短延长杆 ×1","green"],
          ["long",40,85,43,8,"长延长杆 ×1","green"]
        ]
      },
      extension: {
        image: "/samples/missing_long_extension.jpg", file: "missing-long-extension.jpg", dims: "1279 × 1706",
        observed: { large:1, small:1, socket:8, bits:40, short:1, long:0 },
        missing: [{id:"long", name:"长延长杆", expected:1, observed:0, count:1, unit:"根", location:"工具盒底部横向长槽 · 空槽位"}],
        review: 1, status: "missing",
        source: "来源：合成缺失样例 · 固定 Mock 结果",
        boxes: [
          ["large",14,6,26,53,"大号手柄 ×1","green"],
          ["small",40,8,16,51,"小号手柄 ×1","green"],
          ["bits",50,8,21,62,"批头区域 · 约40枚","amber"],
          ["socket",73,7,16,61,"套筒区域 · 8个","green"],
          ["short",40,76,43,8,"短延长杆 ×1","green"],
          ["long",40,85,43,8,"长延长杆缺失","red"]
        ]
      }
    };

    let activeScenario = "socket";
    let customFileUrl = null;
    let isCustomUpload = false;
    let overlayOn = true;
    let toastTimer = null;

    const $ = (id) => document.getElementById(id);
    const image = $("mainImage");
    const overlay = $("overlay");

    function toast(message) {
      const el = $("toast");
      el.textContent = message;
      el.classList.add("show");
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => el.classList.remove("show"), 3200);
    }

    function drawBoxes(boxes) {
      overlay.innerHTML = "";
      if (!overlayOn || isCustomUpload) return;
      boxes.forEach(([id,x,y,w,h,label,kind]) => {
        const box = document.createElement("div");
        box.className = "bbox" + (kind === "red" ? " red" : kind === "amber" ? " amber" : "");
        box.style.left = x + "%";
        box.style.top = y + "%";
        box.style.width = w + "%";
        box.style.height = h + "%";
        if (label) {
          const tag = document.createElement("span");
          tag.className = "bbox-label";
          tag.textContent = label;
          box.appendChild(tag);
        }
        overlay.appendChild(box);
      });
    }

    function renderTable(s) {
      const body = $("inventoryBody");
      body.innerHTML = "";
      let expectedTotal = 0, observedTotal = 0;
      inventoryBase.forEach(item => {
        const observed = s.observed[item.id] ?? 0;
        const diff = Math.max(0, item.expected - observed);
        expectedTotal += item.expected;
        observedTotal += observed;
        const isReview = item.id === "bits";
        const tr = document.createElement("tr");
        const state = diff > 0
          ? `<span class="state missing">缺 ${diff}${item.unit}</span>`
          : isReview ? `<span class="state review">需复核</span>` : `<span class="state ok">正常</span>`;
        tr.innerHTML = `
          <td>${item.name}</td>
          <td class="num">${item.id === "bits" ? "约 " : ""}${item.expected}</td>
          <td class="num">${observed}</td>
          <td class="num" style="color:${diff ? "#c4313b" : "#8490a2"}">${diff ? "-" + diff : "—"}</td>
          <td>${state}</td>`;
        body.appendChild(tr);
      });
      $("expectedMetric").textContent = expectedTotal;
      $("observedMetric").textContent = observedTotal;
      const missingTotal = Object.entries(s.observed).reduce((sum,[id,count]) => {
        const item = inventoryBase.find(x => x.id === id);
        return sum + Math.max(0, (item?.expected ?? 0) - count);
      },0);
      $("missingMetric").textContent = missingTotal;
      $("reviewMetric").textContent = s.review;
    }

    function renderMissing(s) {
      const list = $("missingList");
      list.innerHTML = "";
      if (!s.missing.length) {
        list.innerHTML = `<div class="missing-item" style="border-color:#c9efdd;background:#f7fdf9">
          <div class="missing-symbol" style="background:#ddf6e9;color:#147b59">✓</div>
          <div><div class="missing-name" style="color:#176b4e">暂未发现缺失</div>
          <div class="missing-detail">当前样例与暂定标准清单一致；批头数量仍建议人工确认。</div></div></div>`;
        $("missingCountLabel").textContent = "0 项缺失";
        return;
      }
      $("missingCountLabel").textContent = s.missing.length + " 项待补齐";
      s.missing.forEach(item => {
        const el = document.createElement("div");
        el.className = "missing-item";
        el.innerHTML = `<div class="missing-symbol">!</div>
          <div><div class="missing-name">${item.name} · 缺少 ${item.count}${item.unit}</div>
          <div class="missing-detail">标准 ${item.expected}${item.unit}，识别到 ${item.observed}${item.unit}。请检查对应收纳位置。</div>
          <span class="missing-location">⌖ ${item.location}</span></div>`;
        list.appendChild(el);
      });
    }

    function renderScenario(id) {
      const s = scenarios[id];
      if (!s) return;
      activeScenario = id;
      isCustomUpload = false;
      $("uploadEmpty").style.display = "none";
      image.style.display = "block";
      image.src = s.image;
      $("fileName").textContent = s.file;
      $("imageDimensions").textContent = s.dims;
      $("sourceNote").textContent = s.source;
      $("modeTag").textContent = "参考情景";
      $("modeTag").className = "tag blue";
      $("reanalyzeBtn").textContent = "重新分析 ↻";

      const verdictBox = $("verdictBox");
      const verdictTag = $("verdictTag");
      verdictBox.className = "verdict";
      if (s.status === "complete") {
        verdictBox.classList.add("complete");
        verdictTag.className = "tag green";
        verdictTag.textContent = "清单齐全";
        $("verdictKicker").textContent = "COMPLETE · 暂未发现缺失";
        $("verdictCount").textContent = "0 项缺失";
        $("verdictCopy").textContent = "当前样例与暂定清单一致。批头数量仍为估算值，正式盘点需人工确认。";
      } else {
        verdictTag.className = "tag red";
        verdictTag.textContent = "发现缺失";
        const total = s.missing.reduce((n,x) => n + x.count, 0);
        $("verdictKicker").textContent = "INCOMPLETE · 需补齐";
        $("verdictCount").textContent = `缺少 ${total} 件`;
        $("verdictCopy").textContent = `发现 ${s.missing.length} 项缺失，红色标记用于提示样例中的缺失位置。`;
      }
      renderTable(s);
      renderMissing(s);
      drawBoxes(s.boxes);
      document.querySelectorAll(".sample-card").forEach(btn => btn.classList.toggle("active", btn.dataset.sample === id));
    }

    $("sampleGrid").addEventListener("click", (event) => {
      const btn = event.target.closest(".sample-card");
      if (!btn) return;
      if (customFileUrl) { URL.revokeObjectURL(customFileUrl); customFileUrl = null; }
      renderScenario(btn.dataset.sample);
    });

    $("overlaySwitch").addEventListener("click", () => {
      overlayOn = !overlayOn;
      $("overlaySwitch").classList.toggle("on", overlayOn);
      $("overlaySwitch").setAttribute("aria-pressed", String(overlayOn));
      drawBoxes(scenarios[activeScenario]?.boxes ?? []);
    });

    $("uploadBtn").addEventListener("click", () => $("fileInput").click());
    $("fileInput").addEventListener("change", (event) => {
      const file = event.target.files?.[0];
      if (!file) return;
      if (!["image/jpeg","image/png","image/webp"].includes(file.type)) {
        toast("仅支持 JPG、PNG、WEBP 图片。");
        event.target.value = "";
        return;
      }
      if (file.size > 7 * 1024 * 1024) {
        toast("样例页面限制图片不超过 7 MB。");
        event.target.value = "";
        return;
      }
      if (customFileUrl) URL.revokeObjectURL(customFileUrl);
      customFileUrl = URL.createObjectURL(file);
      isCustomUpload = true;
      image.src = customFileUrl;
      image.style.display = "block";
      $("uploadEmpty").style.display = "block";
      overlay.innerHTML = "";
      $("fileName").textContent = file.name;
      $("imageDimensions").textContent = "自定义上传";
      $("sourceNote").textContent = "来源：用户上传 · 尚未调用模型";
      $("modeTag").textContent = "待真实 API 分析";
      $("modeTag").className = "tag";
      $("verdictBox").className = "verdict review";
      $("verdictTag").className = "tag";
      $("verdictTag").textContent = "等待识别";
      $("verdictKicker").textContent = "WAITING · 未产生识别结论";
      $("verdictCount").textContent = "待分析";
      $("verdictCopy").textContent = "图片已上传并完成预览。当前原型未连接 Qwen-VL，因此不会给出虚构的缺失判断。";
      $("missingList").innerHTML = `<div class="missing-item" style="border-color:#f1dfb8;background:#fffaf0">
        <div class="missing-symbol" style="background:#fff0cf;color:#9b691b">…</div>
        <div><div class="missing-name" style="color:#805915">尚未执行真实识别</div>
        <div class="missing-detail">接入 Qwen API 后，点击分析即可返回工具框、数量和缺失结论。</div></div></div>`;
      $("missingCountLabel").textContent = "待分析";
      $("inventoryBody").innerHTML = `<tr><td colspan="5" style="color:#8994a5;padding:18px 5px">自定义图片尚未识别，不显示模拟数量。</td></tr>`;
      $("expectedMetric").textContent = "52";
      $("observedMetric").textContent = "—";
      $("missingMetric").textContent = "—";
      $("reviewMetric").textContent = "—";
      document.querySelectorAll(".sample-card").forEach(btn => btn.classList.remove("active"));
      toast("图片预览已更新。此原型未连接 Qwen API，不会生成模拟识别结果。");
    });

    $("reanalyzeBtn").addEventListener("click", () => {
      if (isCustomUpload) {
        toast("真实 Qwen API 尚未接入：当前只完成图片预览，不会伪造识别结果。");
        return;
      }
      renderScenario(activeScenario);
      toast("已重新载入固定 Mock 结果；这不是一次真实模型调用。");
    });

    // Initial sample: a missing socket, so the primary UI shows the key missing-item experience.
    renderScenario("socket");
  </script>
</body>
</html>

