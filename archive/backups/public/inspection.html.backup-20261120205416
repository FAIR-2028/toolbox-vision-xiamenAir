<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0b1424" />
  <title>工具盒完整性检查</title>
  <style>
    :root {
      --navy: #0b1424;
      --navy-2: #12213a;
      --ink: #172033;
      --muted: #68758a;
      --line: #e5eaf1;
      --panel: #ffffff;
      --bg: #f4f7fb;
      --blue: #2463eb;
      --blue-soft: #edf3ff;
      --green: #15966a;
      --green-soft: #e9f8f1;
      --red: #d93b45;
      --red-soft: #fff0f0;
      --amber: #b7791f;
      --amber-soft: #fff7e7;
      --shadow: 0 12px 32px rgba(21, 34, 58, .07);
      --radius: 18px;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      color: var(--ink);
      background: var(--bg);
      font-family: Inter, "Segoe UI", "Microsoft YaHei", system-ui, sans-serif;
    }
    button, input { font: inherit; }
    button { cursor: pointer; }
    .topbar {
      height: 70px;
      background: var(--navy);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 clamp(18px, 4vw, 64px);
      gap: 20px;
    }
    .brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .brand-mark {
      width: 38px; height: 38px; border-radius: 12px;
      display: grid; place-items: center;
      background: linear-gradient(145deg, #f5a623, #e77818);
      color: #172033; font-weight: 900; font-size: 17px;
      box-shadow: inset 0 1px 0 rgba(255,255,255,.5);
    }
    .brand-name { font-size: 15px; font-weight: 750; letter-spacing: .02em; }
    .brand-sub { color: #9eacc2; font-size: 10px; letter-spacing: .16em; margin-top: 3px; }
    .top-right { display: flex; align-items: center; gap: 10px; color: #c2ccda; font-size: 12px; }
    .top-pill {
      display: inline-flex; align-items: center; gap: 7px;
      border: 1px solid rgba(255,255,255,.16);
      padding: 7px 11px; border-radius: 999px;
      color: #e8edf5; background: rgba(255,255,255,.05);
    }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: #f3b84a; }
    main { max-width: 1540px; margin: 0 auto; padding: 32px clamp(16px, 3.5vw, 54px) 50px; }
    .page-head {
      display: flex; justify-content: space-between; align-items: flex-end;
      gap: 24px; margin-bottom: 24px; flex-wrap: wrap;
    }
    .eyebrow { color: var(--blue); font-size: 11px; font-weight: 800; letter-spacing: .15em; margin-bottom: 9px; }
    h1 { margin: 0; font-size: clamp(26px, 3vw, 36px); letter-spacing: -.035em; line-height: 1.15; }
    .subtitle { color: var(--muted); margin: 10px 0 0; font-size: 14px; }
    .actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .btn {
      border: 1px solid var(--line); background: #fff; color: #253148;
      padding: 11px 16px; border-radius: 11px; font-size: 13px; font-weight: 700;
      transition: .18s ease; box-shadow: 0 2px 6px rgba(20,30,50,.03);
    }
    .btn:hover { transform: translateY(-1px); box-shadow: 0 7px 18px rgba(20,30,50,.09); }
    .btn-primary { background: var(--blue); border-color: var(--blue); color: white; }
    .btn-dark { background: var(--navy); border-color: var(--navy); color: white; }
    .btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }
    .notice {
      display: flex; gap: 11px; align-items: flex-start;
      padding: 13px 16px; border: 1px solid #f2dcae; background: #fff9eb;
      color: #805915; border-radius: 13px; font-size: 12px; line-height: 1.6;
      margin-bottom: 20px;
    }
    .notice strong { color: #69460d; }
    .notice-icon { font-size: 17px; line-height: 1; }
    .metrics {
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 14px; margin-bottom: 18px;
    }
    .metric {
      background: var(--panel); border: 1px solid var(--line); border-radius: 15px;
      padding: 17px 18px; box-shadow: 0 4px 14px rgba(20,30,50,.025);
    }
    .metric-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .metric-label { color: var(--muted); font-size: 12px; font-weight: 650; }
    .metric-icon {
      width: 29px; height: 29px; border-radius: 9px; display: grid; place-items: center;
      color: var(--blue); background: var(--blue-soft); font-size: 14px; font-weight: 800;
    }
    .metric-value { font-size: 29px; font-weight: 800; letter-spacing: -.04em; margin-top: 10px; }
    .metric-foot { color: #8a96a8; font-size: 11px; margin-top: 3px; }
    .workspace {
      display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(340px, .85fr);
      gap: 18px; align-items: start;
    }
    .card {
      background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius);
      box-shadow: var(--shadow); overflow: hidden;
    }
    .card-head {
      padding: 17px 20px; display: flex; justify-content: space-between; align-items: center;
      gap: 14px; border-bottom: 1px solid var(--line);
    }
    .card-title { font-size: 14px; font-weight: 800; }
    .card-desc { font-size: 11px; color: var(--muted); margin-top: 4px; }
    .tag {
      display: inline-flex; align-items: center; gap: 6px; border-radius: 999px;
      padding: 6px 9px; font-size: 10px; font-weight: 800; white-space: nowrap;
      color: #8b5a10; background: var(--amber-soft); border: 1px solid #f1dfb8;
    }
    .tag.blue { color: #2558bd; background: var(--blue-soft); border-color: #dbe6ff; }
    .tag.green { color: #147b59; background: var(--green-soft); border-color: #c9efdd; }
    .tag.red { color: #b62e38; background: var(--red-soft); border-color: #f6cfd2; }
    .viewer-toolbar {
      display: flex; justify-content: space-between; align-items: center; gap: 10px;
      padding: 12px 18px; background: #fbfcfe; border-bottom: 1px solid var(--line);
      flex-wrap: wrap;
    }
    .file-meta { display: flex; align-items: center; gap: 8px; min-width: 0; color: #59677d; font-size: 11px; }
    .file-name { color: #253148; font-weight: 750; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 230px; }
    .view-tools { display: flex; gap: 8px; align-items: center; color: #68758a; font-size: 11px; }
    .switch {
      border: 0; background: #d9e0eb; border-radius: 999px; width: 34px; height: 19px;
      padding: 2px; display: inline-flex; align-items: center; transition: .2s;
    }
    .switch::after { content: ""; width: 15px; height: 15px; border-radius: 50%; background: white; transition: .2s; box-shadow: 0 1px 3px #0002; }
    .switch.on { background: var(--blue); justify-content: flex-end; }
    .image-stage {
      background: #e9edf3; padding: 20px; display: grid; place-items: center;
      min-height: 570px; position: relative;
    }
    .photo-wrap {
      position: relative; width: min(100%, 470px); border-radius: 10px;
      overflow: hidden; background: #fff; box-shadow: 0 10px 30px rgba(15,25,40,.18);
      line-height: 0;
    }
    .photo-wrap img { display: block; width: 100%; height: auto; max-height: 700px; object-fit: contain; }
    .overlay { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    .bbox { position: absolute; border: 2px solid #19a66f; background: rgba(25,166,111,.06); border-radius: 5px; }
    .bbox.red { border-color: #e13f4b; background: rgba(225,63,75,.10); border-style: dashed; }
    .bbox.amber { border-color: #d59a28; background: rgba(213,154,40,.10); border-style: dashed; }
    .bbox-label {
      position: absolute; left: -2px; top: -22px; max-width: 190px;
      background: #15966a; color: white; padding: 4px 7px; border-radius: 5px 5px 5px 0;
      font-size: 10px; line-height: 1.2; font-weight: 800; white-space: nowrap;
    }
    .bbox.red .bbox-label { background: #d93b45; }
    .bbox.amber .bbox-label { background: #b7791f; }
    .viewer-footer {
      display: flex; justify-content: space-between; gap: 10px; padding: 12px 18px;
      border-top: 1px solid var(--line); color: #8490a2; font-size: 10px;
    }
    .legend { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
    .legend-item { display: inline-flex; align-items: center; gap: 6px; }
    .legend-dot { width: 8px; height: 8px; border-radius: 2px; background: var(--green); }
    .legend-dot.red { background: var(--red); }
    .legend-dot.amber { background: #d59a28; }
    .result-panel { display: flex; flex-direction: column; gap: 14px; }
    .verdict {
      padding: 19px; border-radius: 16px; background: var(--red-soft);
      border: 1px solid #f4c9cd;
    }
    .verdict.complete { background: var(--green-soft); border-color: #c9efdd; }
    .verdict.review { background: var(--amber-soft); border-color: #f1dfb8; }
    .verdict-kicker { font-size: 11px; font-weight: 800; letter-spacing: .1em; color: #b62e38; }
    .verdict.complete .verdict-kicker { color: #147b59; }
    .verdict.review .verdict-kicker { color: #9b691b; }
    .verdict-main { display: flex; justify-content: space-between; align-items: flex-end; gap: 10px; margin-top: 8px; }
    .verdict-count { font-size: 34px; font-weight: 900; letter-spacing: -.05em; color: #b62e38; line-height: 1; }
    .verdict.complete .verdict-count { color: #147b59; }
    .verdict.review .verdict-count { color: #9b691b; }
    .verdict-copy { color: #8b3d43; font-size: 12px; line-height: 1.55; margin-top: 10px; }
    .verdict.complete .verdict-copy { color: #267357; }
    .verdict.review .verdict-copy { color: #8a641f; }
    .missing-list { display: flex; flex-direction: column; gap: 9px; }
    .missing-item {
      border: 1px solid #f1d1d4; background: #fffafa; border-radius: 13px;
      padding: 13px 14px; display: flex; gap: 12px; align-items: flex-start;
    }
    .missing-symbol {
      flex: 0 0 30px; height: 30px; border-radius: 9px; display: grid; place-items: center;
      background: #ffe3e5; color: #c4313b; font-weight: 900; font-size: 15px;
    }
    .missing-name { font-size: 13px; font-weight: 800; color: #7f2029; }
    .missing-detail { font-size: 11px; color: #8c6064; margin-top: 4px; line-height: 1.55; }
    .missing-location { display: inline-flex; margin-top: 7px; color: #b62e38; font-size: 10px; font-weight: 800; }
    .section-card { padding: 16px 18px; }
    .section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 10px; }
    .section-head h3 { margin: 0; font-size: 13px; }
    .section-head span { font-size: 10px; color: #8a96a8; }
    .inventory { width: 100%; border-collapse: collapse; font-size: 11px; }
    .inventory th { text-align: left; color: #8a96a8; font-size: 10px; font-weight: 700; padding: 8px 5px; border-bottom: 1px solid var(--line); }
    .inventory td { padding: 10px 5px; border-bottom: 1px solid #f0f2f6; }
    .inventory tr:last-child td { border-bottom: 0; }
    .inventory td:first-child { font-weight: 700; color: #344158; }
    .num { font-variant-numeric: tabular-nums; font-weight: 750; }
    .state { font-size: 10px; font-weight: 800; border-radius: 999px; padding: 4px 7px; white-space: nowrap; }
    .state.ok { color: #167b59; background: var(--green-soft); }
    .state.missing { color: #b62e38; background: var(--red-soft); }
    .state.review { color: #946318; background: var(--amber-soft); }
    .samples { margin-top: 18px; }
    .sample-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; padding: 15px; }
    .sample-card {
      border: 1px solid var(--line); background: #fff; border-radius: 13px; overflow: hidden;
      text-align: left; padding: 0; color: var(--ink); transition: .18s; position: relative;
    }
    .sample-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(20,30,50,.08); }
    .sample-card.active { border: 2px solid var(--blue); box-shadow: 0 0 0 3px rgba(36,99,235,.09); }
    .sample-thumb { height: 125px; background: #edf1f6; display: grid; place-items: center; overflow: hidden; }
    .sample-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
    .sample-copy { padding: 10px 11px 12px; }
    .sample-title { font-size: 11px; font-weight: 800; }
    .sample-sub { font-size: 10px; color: #8490a2; margin-top: 4px; }
    .sample-badge { position: absolute; top: 8px; left: 8px; background: rgba(11,20,36,.82); color: #fff; font-size: 9px; padding: 4px 6px; border-radius: 5px; }
    .bottom-note { color: #8994a5; font-size: 10px; line-height: 1.7; margin: 14px 3px 0; }
    .toast {
      position: fixed; bottom: 24px; left: 50%; transform: translate(-50%, 20px);
      background: #172033; color: white; padding: 12px 16px; border-radius: 11px;
      font-size: 12px; box-shadow: 0 12px 35px #0b142455; opacity: 0; pointer-events: none;
      transition: .25s; z-index: 20; max-width: min(90vw, 560px); text-align: center;
    }
    .toast.show { opacity: 1; transform: translate(-50%, 0); }
    .upload-empty {
      display: none; text-align: center; color: #536176; font-size: 12px; line-height: 1.7;
      padding: 24px;
    }
    .upload-empty strong { display: block; color: #172033; font-size: 14px; margin-bottom: 5px; }
    @media (max-width: 1050px) {
      .workspace { grid-template-columns: 1fr; }
      .result-panel { display: grid; grid-template-columns: 1fr 1fr; align-items: start; }
      .result-panel .section-card { grid-column: 1 / -1; }
      .image-stage { min-height: auto; }
      .photo-wrap { width: min(100%, 440px); }
    }
    @media (max-width: 700px) {
      .topbar { height: 62px; padding: 0 15px; }
      .top-right .top-pill:nth-child(2) { display: none; }
      main { padding: 23px 13px 35px; }
      .page-head { align-items: flex-start; }
      .actions { width: 100%; }
      .actions .btn { flex: 1; }
      .metrics { grid-template-columns: repeat(2, 1fr); gap: 9px; }
      .metric { padding: 13px; }
      .metric-value { font-size: 25px; }
      .result-panel { display: flex; }
      .sample-grid { grid-template-columns: repeat(2, 1fr); padding: 10px; gap: 9px; }
      .sample-thumb { height: 105px; }
      .image-stage { padding: 10px; }
      .viewer-footer { flex-direction: column; }
    }
  </style>
<style>
body{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;line-height:1.55}.topbar{height:78px}.brand-name{font-size:18px}.brand-sub{font-size:11px}.top-right{font-size:13px}main{max-width:1580px;padding-top:30px}.eyebrow{font-size:12px}h1{font-size:32px}.subtitle{font-size:15px}.btn{font-size:14px;padding:12px 18px}.notice{font-size:13px}.metric{padding:20px 22px}.metric-label{font-size:14px}.metric-value{font-size:36px;font-weight:700}.metric-foot{font-size:12px}.workspace{grid-template-columns:minmax(0,1.45fr) minmax(390px,.85fr);gap:22px}.card{border-radius:15px}.card-title{font-size:17px}.card-desc{font-size:12px}.file-meta,.view-tools{font-size:13px}.image-stage{min-height:600px;padding:26px}.photo-wrap{width:min(100%,430px)}.bbox-label{font-size:11px;font-weight:650}.viewer-footer{font-size:12px}.section-head h3{font-size:16px}.section-head span{font-size:12px}.verdict-kicker{font-size:12px}.verdict-count{font-size:36px}.verdict-copy{font-size:14px}.missing-name{font-size:16px}.missing-detail{font-size:13px}.missing-location{font-size:12px}.inventory{font-size:13px}.inventory th{font-size:12px}.inventory td{padding:12px 5px}.state{font-size:11px}.tag{font-size:11px}.sample-grid{gap:16px;padding:20px}.sample-thumb{height:145px}.sample-title{font-size:15px}.sample-sub{font-size:12px}.sample-badge{font-size:11px}.bottom-note{font-size:12px}.photo-wrap img{max-height:none}.verdict-main>.tag{display:none}@media(max-width:1050px){.workspace{grid-template-columns:1fr}.image-stage{min-height:0}.result-panel{grid-template-columns:1fr 1fr}}@media(max-width:700px){.result-panel{display:flex}.brand-name{font-size:15px}.brand-sub{font-size:9px}.top-right{font-size:11px}.metric{padding:15px}.metric-value{font-size:29px}.sample-title{font-size:13px}.sample-sub{font-size:11px}.sample-thumb{height:115px}}
